# Chiave API di OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Modello OpenAI da usare (deve supportare i tool/function calling)
OPENAI_MODEL=gpt-4o-mini

# Chiave API di EcoFreight (https://ecofreight.co -> dashboard -> API keys)
ECOFREIGHT_API_KEY=ef_live_...

# Origine consentita per le richieste CORS dal frontend (es. https://tuo-sito.netlify.app)
# Usa * solo in sviluppo locale
ALLOWED_ORIGIN=*

# Percorso del file SQLite (relativo alla cartella backend/)
DATABASE_PATH=database/data.sqlite
